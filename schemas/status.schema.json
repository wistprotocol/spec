{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deltacommons.org/schemas/status.schema.json",
  "title": "DeltaCommons Publisher Status (DC-2 §7.1)",
  "type": "object",
  "required": ["dc_version", "domain", "last_pull_at", "quota_remaining", "state", "rejections"],
  "additionalProperties": false,
  "properties": {
    "dc_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "domain": {"type": "string", "format": "hostname"},
    "last_pull_at": {"type": ["string", "null"], "format": "date-time"},
    "quota_remaining": {"type": "integer", "minimum": 0},
    "state": {"enum": ["new", "active", "sanctioned_quarantine", "delisted"]},
    "rejections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "at"],
        "additionalProperties": false,
        "properties": {
          "code": {"type": "string", "pattern": "^DC[1-4]-E[0-9]{2}$"},
          "at": {"type": "string", "format": "date-time"},
          "delta_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "detail": {"type": "string", "maxLength": 256}
        }
      }
    }
  }
}
