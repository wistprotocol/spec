{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wistprotocol.org/schemas/snapshot-index.schema.json",
  "title": "WIST Snapshot Index (WIST-3)",
  "type": "object",
  "required": ["index", "sig"],
  "additionalProperties": false,
  "properties": {
    "index": {
      "type": "object",
      "required": ["wist_version", "updated_at", "snapshots"],
      "additionalProperties": false,
      "properties": {
        "wist_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
        "updated_at": {"type": "string", "format": "date-time"},
        "snapshots": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "required": ["snapshot_date", "tree_size", "manifest_url", "content_digest"],
            "additionalProperties": false,
            "properties": {
              "snapshot_date": {"type": "string", "format": "date"},
              "tree_size": {"type": "integer", "minimum": 0, "description": "The tree size Checkpoint `epoch_number` states for this Snapshot, restated from its manifest (WIST-3 §6, §7)."},
              "manifest_url": {"type": "string", "pattern": "^[^\\s\"]{1,500}/manifest\\.json$"},
              "content_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
            }
          }
        }
      }
    },
    "sig": {
      "type": "object",
      "required": ["key_id", "alg", "value"],
      "additionalProperties": false,
      "properties": {
        "key_id": {"type": "string", "maxLength": 64},
        "alg": {"const": "Ed25519"},
        "value": {"type": "string", "pattern": "^[A-Za-z0-9_-]{85}[AQgw]$(?![\\s\\S])"}
      }
    }
  }
}
