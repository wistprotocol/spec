{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wistprotocol.org/schemas/snapshot-manifest.schema.json",
  "title": "WIST Snapshot Manifest (WIST-3)",
  "type": "object",
  "required": ["manifest", "sig"],
  "additionalProperties": false,
  "properties": {
    "manifest": {
      "type": "object",
      "required": ["wist_version", "snapshot_date", "epoch_number", "tree_size", "root_hash",
                   "content_digest", "state", "files"],
      "additionalProperties": false,
      "properties": {
        "wist_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
        "snapshot_date": {"type": "string", "format": "date"},
        "epoch_number": {"type": "integer", "minimum": 0, "description": "The Epoch the Snapshot is taken at (WIST-3 §7)."},
        "tree_size": {"type": "integer", "minimum": 0, "description": "The tree size Checkpoint `epoch_number` states (WIST-3 §7)."},
        "root_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "description": "The root hash of the tree at `tree_size` (WIST-3 §7)."},
        "content_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "state": {
          "type": "object",
          "required": ["path", "sha256", "bytes", "state_digest"],
          "additionalProperties": false,
          "properties": {
            "path": {"type": "string", "maxLength": 256},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "bytes": {"type": "integer", "minimum": 0},
            "state_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
          }
        },
        "shards": {
          "type": "object",
          "required": ["count", "digests"],
          "additionalProperties": false,
          "properties": {
            "count": {"type": "integer", "minimum": 1},
            "digests": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
            }
          }
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["path", "sha256", "bytes", "tier"],
            "additionalProperties": false,
            "properties": {
              "path": {"type": "string", "maxLength": 256},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "bytes": {"type": "integer", "minimum": 0},
              "tier": {"enum": [0, 1]},
              "shard": {"type": "integer", "minimum": 0}
            }
          }
        }
      }
    },
    "sig": {
      "type": "object",
      "required": ["key_id", "alg", "value"],
      "additionalProperties": false,
      "properties": {
        "key_id": {"type": "string", "maxLength": 64},
        "alg": {"const": "Ed25519"},
        "value": {"type": "string", "pattern": "^[A-Za-z0-9_-]{85}[AQgw]$(?![\\s\\S])"}
      }
    }
  }
}
