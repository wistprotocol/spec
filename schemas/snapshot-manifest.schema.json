{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deltacommons.org/schemas/snapshot-manifest.schema.json",
  "title": "DeltaCommons Snapshot Manifest (DC-3)",
  "type": "object",
  "required": ["manifest", "sig"],
  "additionalProperties": false,
  "properties": {
    "manifest": {
      "type": "object",
      "required": ["dc_version", "snapshot_date", "log_position", "anchor_block_hash",
                   "content_digest", "embedding_model", "files"],
      "additionalProperties": false,
      "properties": {
        "dc_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
        "snapshot_date": {"type": "string", "format": "date"},
        "log_position": {"type": "integer", "minimum": 0},
        "anchor_block_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "content_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "embedding_model": {
          "type": "object",
          "required": ["name", "version", "dim", "quantization"],
          "additionalProperties": false,
          "properties": {
            "name": {"type": "string", "maxLength": 128},
            "version": {"type": "string", "maxLength": 64},
            "dim": {"type": "integer", "minimum": 1},
            "quantization": {"enum": ["none", "int8", "binary"]}
          }
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["path", "sha256", "bytes", "tier"],
            "additionalProperties": false,
            "properties": {
              "path": {"type": "string", "maxLength": 256},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "bytes": {"type": "integer", "minimum": 0},
              "tier": {"enum": [0, 1]}
            }
          }
        }
      }
    },
    "sig": {
      "type": "object",
      "required": ["key_id", "alg", "value"],
      "additionalProperties": false,
      "properties": {
        "key_id": {"type": "string", "maxLength": 64},
        "alg": {"const": "Ed25519"},
        "value": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}$"}
      }
    }
  }
}
