{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wistprotocol.org/schemas/snapshot-state.schema.json",
  "title": "WIST Snapshot State Artifact (WIST-3 §7)",
  "type": "object",
  "required": ["state", "sig"],
  "additionalProperties": false,
  "properties": {
    "state": {
      "type": "object",
      "required": ["wist_version", "tree_size", "entries"],
      "additionalProperties": false,
      "description": "The protocol state at tree_size, as one tuple per live item and per removed Aggregator key. Each tuple is a JSON array whose first member names its kind; WIST-3 §7's table is the normative inventory of kinds and their fields, in prose, on the pattern WIST-4 §5.1 sets for Registry Update details. Every field is Log-derived — no page content — so the state_digest over these tuples survives any withdrawal.",
      "properties": {
        "wist_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
        "tree_size": {"type": "integer", "minimum": 0, "description": "The manifest's `tree_size`, the tree size Checkpoint `epoch_number` states (WIST-3 §7)."},
        "entries": {
          "type": "array",
          "items": {
            "type": "array",
            "oneOf": [
              {
                "prefixItems": [
                  {"const": "aggregator_key"},
                  {"type": "string", "maxLength": 64},
                  {"type": "string", "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$(?![\\s\\S])"},
                  {"type": "integer", "minimum": 0},
                  {"oneOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
                  {"type": ["object", "null"]},
                  {"type": ["object", "null"]}
                ],
                "items": false,
                "minItems": 7
              },
              {
                "prefixItems": [
                  {"const": "declaration"},
                  {"type": "string", "format": "wist-canonical-host", "minLength": 1, "maxLength": 253, "pattern": "^[a-z0-9-]{1,63}(\\.[a-z0-9-]{1,63})*$(?![\\s\\S])", "description": "Must equal its own Canonical Host under WIST-1 sections 2 and 5.1, including Unicode 16.0 UTS #46 A-label validation; the pattern alone is insufficient."},
                  {"type": "object"},
                  {"type": "integer", "minimum": 0},
                  {"type": "integer", "minimum": 0}
                ],
                "items": false,
                "minItems": 5
              },
              {
                "prefixItems": [
                  {"const": "pending_declaration"},
                  {"type": "string", "format": "wist-canonical-host", "minLength": 1, "maxLength": 253, "pattern": "^[a-z0-9-]{1,63}(\\.[a-z0-9-]{1,63})*$(?![\\s\\S])", "description": "Must equal its own Canonical Host under WIST-1 sections 2 and 5.1, including Unicode 16.0 UTS #46 A-label validation; the pattern alone is insufficient."},
                  {"type": "object"},
                  {"type": "integer", "minimum": 0},
                  {"type": "integer", "minimum": 0}
                ],
                "items": false,
                "minItems": 5
              },
              {
                "prefixItems": [
                  {"const": "parameter"},
                  {"type": "string"},
                  {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-5][0-9]Z$"},
                  {"type": "integer"}
                ],
                "items": false,
                "minItems": 4
              },
              {
                "prefixItems": [
                  {"const": "recovery_window"},
                  {"type": "string", "format": "wist-canonical-host", "minLength": 1, "maxLength": 253, "pattern": "^[a-z0-9-]{1,63}(\\.[a-z0-9-]{1,63})*$(?![\\s\\S])", "description": "Must equal its own Canonical Host under WIST-1 sections 2 and 5.1, including Unicode 16.0 UTS #46 A-label validation; the pattern alone is insufficient."},
                  {"type": "integer", "minimum": 0},
                  {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-5][0-9]Z$"},
                  {"type": "object"},
                  {"type": "integer", "minimum": 0}
                ],
                "items": false,
                "minItems": 6
              },
              {
                "prefixItems": [
                  {"const": "withdrawal"},
                  {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
                  {"type": "string", "format": "wist-canonical-host", "minLength": 1, "maxLength": 253, "pattern": "^[a-z0-9-]{1,63}(\\.[a-z0-9-]{1,63})*$(?![\\s\\S])", "description": "Must equal its own Canonical Host under WIST-1 sections 2 and 5.1, including Unicode 16.0 UTS #46 A-label validation; the pattern alone is insufficient."},
                  {"type": "integer", "minimum": 0}
                ],
                "items": false,
                "minItems": 4
              },
              {
                "prefixItems": [
                  {"const": "label"},
                  {"type": "string", "format": "wist-canonical-host", "minLength": 1, "maxLength": 253, "pattern": "^[a-z0-9-]{1,63}(\\.[a-z0-9-]{1,63})*$(?![\\s\\S])", "description": "Must equal its own Canonical Host under WIST-1 sections 2 and 5.1, including Unicode 16.0 UTS #46 A-label validation; the pattern alone is insufficient."},
                  {"type": "string", "minLength": 1, "maxLength": 2048},
                  {"type": "string", "minLength": 3, "maxLength": 64, "pattern": "^[a-z0-9-]{1,63}(\\.[a-z0-9-]{1,63})*:[a-z0-9-]+$(?![\\s\\S])"},
                  {"oneOf": [{"type": "integer", "minimum": 0, "maximum": 1000000}, {"type": "null"}]},
                  {"type": "string", "format": "wist-publisher-timestamp", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])[Tt]([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?([Zz]|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$(?![\\s\\S])"},
                  {"oneOf": [{"type": "string", "format": "wist-publisher-timestamp", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])[Tt]([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?([Zz]|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$(?![\\s\\S])"}, {"type": "null"}]},
                  {"oneOf": [{"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, {"type": "null"}]},
                  {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
                  {"type": "integer", "minimum": 0}
                ],
                "items": false,
                "minItems": 10
              },
              {
                "prefixItems": [
                  {"const": "record"},
                  {"type": "string", "format": "wist-canonical-host", "minLength": 1, "maxLength": 253, "pattern": "^[a-z0-9-]{1,63}(\\.[a-z0-9-]{1,63})*$(?![\\s\\S])", "description": "Must equal its own Canonical Host under WIST-1 sections 2 and 5.1, including Unicode 16.0 UTS #46 A-label validation; the pattern alone is insufficient."},
                  {"type": "string", "description": "The URL, as the Item spells it."},
                  {"type": "object", "description": "The record's Item, of kind page, verbatim as sealed (WIST-1 section 3.3)."},
                  {"type": "string", "pattern": "^[a-z0-9]([a-z0-9-]{0,30}[a-z0-9])?$(?![\\s\\S])", "description": "A Collection name in the form of WIST-1 section 5.1."},
                  {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "description": "The Catalog ID of the Catalog the Item was proved against."},
                  {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-5][0-9]Z$", "description": "The generated_at of the Catalog the Item was proved against, in the whole-second profile of WIST-3 section 3.1."}
                ],
                "items": false,
                "minItems": 7
              },
              {
                "prefixItems": [
                  {"const": "suffix_list"},
                  {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
                  {"type": "integer", "minimum": 0}
                ],
                "items": false,
                "minItems": 3
              },
              {
                "prefixItems": [
                  {"const": "dispute"},
                  {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
                  {"type": "string", "format": "wist-canonical-host", "minLength": 1, "maxLength": 253, "pattern": "^[a-z0-9-]{1,63}(\\.[a-z0-9-]{1,63})*$(?![\\s\\S])", "description": "Must equal its own Canonical Host under WIST-1 sections 2 and 5.1, including Unicode 16.0 UTS #46 A-label validation; the pattern alone is insufficient."},
                  {"oneOf": [{"type": "string", "minLength": 1, "maxLength": 2048}, {"type": "null"}]},
                  {"type": "string", "format": "wist-publisher-timestamp", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])[Tt]([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?([Zz]|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$(?![\\s\\S])"},
                  {"type": "integer", "minimum": 0}
                ],
                "items": false,
                "minItems": 6
              },
              {
                "prefixItems": [
                  {"const": "collection"},
                  {"type": "string", "format": "wist-canonical-host", "minLength": 1, "maxLength": 253, "pattern": "^[a-z0-9-]{1,63}(\\.[a-z0-9-]{1,63})*$(?![\\s\\S])", "description": "Must equal its own Canonical Host under WIST-1 sections 2 and 5.1, including Unicode 16.0 UTS #46 A-label validation; the pattern alone is insufficient."},
                  {"type": "string", "pattern": "^[a-z0-9]([a-z0-9-]{0,30}[a-z0-9])?$(?![\\s\\S])", "description": "The Collection name, in the form of WIST-1 section 5.1."},
                  {"type": "object", "description": "The latest Catalog's Envelope, verbatim as sealed (WIST-1 section 3.5)."},
                  {"type": "integer", "minimum": 0}
                ],
                "items": false,
                "minItems": 5
              },
              {
                "prefixItems": [
                  {"const": "removal"},
                  {"type": "string", "format": "wist-canonical-host", "minLength": 1, "maxLength": 253, "pattern": "^[a-z0-9-]{1,63}(\\.[a-z0-9-]{1,63})*$(?![\\s\\S])", "description": "Must equal its own Canonical Host under WIST-1 sections 2 and 5.1, including Unicode 16.0 UTS #46 A-label validation; the pattern alone is insufficient."},
                  {"type": "string", "description": "The URL, as the Item of kind removed spells it."},
                  {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "description": "The Item ID of the Item of kind removed that removed the record."},
                  {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "description": "The Catalog ID of the Catalog that Item was proved against."},
                  {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-5][0-9]Z$", "description": "The generated_at of the Catalog the Item of kind removed was proved against, in the whole-second profile of WIST-3 section 3.1."}
                ],
                "items": false,
                "minItems": 6
              }
            ]
          }
        }
      }
    },
    "sig": {
      "type": "object",
      "required": ["key_id", "alg", "value"],
      "additionalProperties": false,
      "properties": {
        "key_id": {"type": "string", "maxLength": 64},
        "alg": {"const": "Ed25519"},
        "value": {"type": "string", "pattern": "^[A-Za-z0-9_-]{85}[AQgw]$(?![\\s\\S])"}
      }
    }
  }
}
