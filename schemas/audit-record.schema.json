{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deltacommons.org/schemas/audit-record.schema.json",
  "title": "DeltaCommons Audit Record (DC-4)",
  "type": "object",
  "required": ["record", "sig"],
  "additionalProperties": false,
  "properties": {
    "record": {
      "type": "object",
      "required": ["dc_version", "audited_delta", "auditor_id", "fetched_at", "verdict", "vrf_proof"],
      "additionalProperties": false,
      "description": "Every content-derived value an Audit Record seals is a commitment keyed by the salt of the audit's Reference Payload (DC-4 §5), never a bare digest: withdrawing that Payload destroys the salt and renders these commitments uncheckable at the same instant as the Delta's own.",
      "properties": {
        "dc_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
        "audited_delta": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "auditor_id": {"type": "string", "format": "hostname"},
        "fetched_at": {"type": "string", "format": "date-time"},
        "response_commitment": {"type": "string", "pattern": "^hmac-sha256:[0-9a-f]{64}$"},
        "ref_extract_commitment": {"type": "string", "pattern": "^hmac-sha256:[0-9a-f]{64}$"},
        "similarity": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "verdict": {"enum": ["consistent", "inconsistent", "unreachable", "dynamic_variance", "not_auditable"]},
        "evidence_commitment": {"type": "string", "pattern": "^hmac-sha256:[0-9a-f]{64}$"},
        "vrf_proof": {"type": "string", "pattern": "^[0-9a-f]{160}$"}
      }
    },
    "sig": {
      "type": "object",
      "required": ["key_id", "alg", "value"],
      "additionalProperties": false,
      "properties": {
        "key_id": {"type": "string", "maxLength": 64},
        "alg": {"const": "Ed25519"},
        "value": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}$"}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["record"],
        "properties": {"record": {"required": ["verdict"], "properties": {"verdict": {"enum": ["consistent", "inconsistent", "dynamic_variance"]}}}}
      },
      "then": {
        "comment": "similarity is not required here: a `delete` audit reports no similarity (DC-4 §5), and a Record names a Delta rather than its change type, so the schema cannot tell the cases apart.",
        "properties": {"record": {"required": ["response_commitment", "ref_extract_commitment", "evidence_commitment"]}}
      }
    },
    {
      "if": {
        "required": ["record"],
        "properties": {"record": {"required": ["verdict"], "properties": {"verdict": {"enum": ["unreachable", "not_auditable"]}}}}
      },
      "then": {
        "properties": {
          "record": {
            "allOf": [
              {"not": {"required": ["response_commitment"]}},
              {"not": {"required": ["ref_extract_commitment"]}},
              {"not": {"required": ["similarity"]}},
              {"not": {"required": ["evidence_commitment"]}}
            ]
          }
        }
      }
    }
  ]
}
