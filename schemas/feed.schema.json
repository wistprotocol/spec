{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wistprotocol.org/schemas/feed.schema.json",
  "title": "WIST Publisher Feed (WIST-2)",
  "type": "object",
  "required": ["feed", "sig"],
  "additionalProperties": false,
  "properties": {
    "feed": {
      "type": "object",
      "required": ["wist_version", "domain", "generated_at", "deltas", "next"],
      "additionalProperties": false,
      "properties": {
        "wist_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$(?![\\s\\S])"},
        "domain": {"type": "string", "format": "wist-canonical-host", "minLength": 1, "maxLength": 253, "pattern": "^[a-z0-9-]{1,63}(\\.[a-z0-9-]{1,63})*$(?![\\s\\S])", "description": "Must equal its own Canonical Host under WIST-1 sections 2 and 5.1, including Unicode 16.0 UTS #46 A-label validation; the pattern alone is insufficient."},
        "generated_at": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-5][0-9]Z$(?![\\s\\S])", "description": "RFC 3339 UTC at whole-second precision with a literal trailing Z, the form block.schema.json fixes for `sealed_at`. WIST-2 §3.2 resolves a sealed Page's Key Set by comparing this value against `publisher_declaration` Entries' Block `sealed_at`, so it is compared against Block timestamps by every validator and is written in the one form they carry."},
        "deltas": {
          "type": "array",
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$(?![\\s\\S])"}
        },
        "next": {"type": ["string", "null"], "pattern": "^https://[^#]*$"}
      }
    },
    "sig": {
      "type": "object",
      "required": ["key_id", "alg", "value"],
      "additionalProperties": false,
      "properties": {
        "key_id": {"type": "string", "maxLength": 64},
        "alg": {"const": "Ed25519"},
        "value": {"type": "string", "pattern": "^[A-Za-z0-9_-]{85}[AQgw]$(?![\\s\\S])"}
      }
    }
  }
}
