{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deltacommons.org/schemas/checkpoint.schema.json",
  "title": "DeltaCommons Signed Checkpoint (DC-3)",
  "type": "object",
  "required": ["checkpoint", "sig"],
  "additionalProperties": false,
  "properties": {
    "checkpoint": {
      "type": "object",
      "required": ["dc_version", "block_number", "block_hash", "sealed_at"],
      "additionalProperties": false,
      "properties": {
        "dc_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
        "block_number": {"type": "integer", "minimum": 0},
        "block_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "sealed_at": {"type": "string", "format": "date-time"}
      }
    },
    "sig": {
      "type": "object",
      "required": ["key_id", "alg", "value"],
      "additionalProperties": false,
      "properties": {
        "key_id": {"type": "string", "maxLength": 64},
        "alg": {"const": "Ed25519"},
        "value": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}$"}
      }
    }
  }
}
