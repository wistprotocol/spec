{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deltacommons.org/schemas/delta.schema.json",
  "title": "DeltaCommons Delta Envelope (DC-1)",
  "type": "object",
  "required": ["delta", "sig"],
  "additionalProperties": false,
  "properties": {
    "delta": {
      "type": "object",
      "required": ["dc_version", "url", "change_type", "observed_at", "meta"],
      "additionalProperties": false,
      "properties": {
        "dc_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
        "url": {"type": "string", "format": "uri", "pattern": "^https://[^#]*$"},
        "change_type": {"enum": ["new", "update", "delete", "attest"]},
        "observed_at": {"type": "string", "format": "date-time"},
        "prev": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "payload": {
          "type": "object",
          "required": ["commitment", "alg", "bytes"],
          "additionalProperties": false,
          "description": "Salted commitment to the Delta's content (DC-1 §3.6). The content itself travels as a Payload alongside the Block (DC-3 §6.1) and never enters the Log.",
          "properties": {
            "commitment": {"type": "string", "pattern": "^hmac-sha256:[0-9a-f]{64}$"},
            "alg": {"const": "HMAC-SHA256"},
            "bytes": {"type": "integer", "minimum": 0, "maximum": 34816}
          }
        },
        "meta": {
          "type": "object",
          "required": ["lang"],
          "additionalProperties": false,
          "properties": {
            "lang": {"type": "string", "pattern": "^[a-z]{2}(-[A-Za-z0-9]+)?$"},
            "topics": {"type": "array", "items": {"type": "string", "maxLength": 64}, "maxItems": 10},
            "license": {"type": "string", "maxLength": 64}
          }
        }
      }
    },
    "sig": {
      "type": "object",
      "required": ["key_id", "alg", "value"],
      "additionalProperties": false,
      "properties": {
        "key_id": {"type": "string", "maxLength": 64},
        "alg": {"const": "Ed25519"},
        "value": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}$"}
      }
    }
  }
}
