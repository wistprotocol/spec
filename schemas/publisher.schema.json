{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wistprotocol.org/schemas/publisher.schema.json",
  "title": "WIST Publisher Declaration (WIST-1)",
  "$comment": "WIST-1 section 5.1 defines each key entry as an Ed25519 JWK whose kid is its RFC 7638 thumbprint and whose nbf/exp are NumericDate integers; a kid that is not the thumbprint of x, or an exp not greater than nbf, is WIST1-E14. Section 5.2 additionally requires each public key to appear once across keys and recovery_keys, authenticated signer resolution, and the next_keys commitment. Section 4 derives usable cryptographic keys without deleting signed entries or relaxing uniqueness, disjointness or recovery protection.",
  "type": "object",
  "required": [
    "publisher",
    "sig"
  ],
  "additionalProperties": false,
  "properties": {
    "publisher": {
      "type": "object",
      "required": [
        "wist_version",
        "domain",
        "keys",
        "seq"
      ],
      "additionalProperties": false,
      "properties": {
        "wist_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "domain": {
          "type": "string",
          "format": "wist-canonical-host",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[a-z0-9-]{1,63}(\\.[a-z0-9-]{1,63})*$(?![\\s\\S])",
          "description": "Must equal its own Canonical Host under WIST-1 sections 2 and 5.1, including Unicode 16.0 UTS #46 A-label validation; the pattern alone is insufficient."
        },
        "seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "prev_declaration": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "subdomain_scope": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "wist-canonical-host",
            "minLength": 1,
            "maxLength": 253,
            "pattern": "^[a-z0-9-]{1,63}(\\.[a-z0-9-]{1,63})*$(?![\\s\\S])",
            "description": "Must equal its own Canonical Host under WIST-1 sections 2 and 5.1, including Unicode 16.0 UTS #46 A-label validation; the pattern alone is insufficient."
          }
        },
        "keys": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "kty",
              "crv",
              "x",
              "kid",
              "nbf"
            ],
            "additionalProperties": false,
            "properties": {
              "kty": {
                "const": "OKP"
              },
              "crv": {
                "const": "Ed25519"
              },
              "x": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$(?![\\s\\S])"
              },
              "kid": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$(?![\\s\\S])",
                "description": "The RFC 7638 JWK thumbprint of this entry (WIST-1 section 5.1); the pattern alone does not establish it."
              },
              "nbf": {
                "type": "integer",
                "minimum": 0,
                "maximum": 253402300799
              },
              "exp": {
                "type": "integer",
                "minimum": 1,
                "maximum": 253402300799,
                "description": "Must be greater than nbf (WIST-1 section 5.1)."
              }
            }
          }
        },
        "recovery_keys": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "kty",
              "crv",
              "x",
              "kid",
              "nbf"
            ],
            "additionalProperties": false,
            "properties": {
              "kty": {
                "const": "OKP"
              },
              "crv": {
                "const": "Ed25519"
              },
              "x": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$(?![\\s\\S])"
              },
              "kid": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$(?![\\s\\S])",
                "description": "The RFC 7638 JWK thumbprint of this entry (WIST-1 section 5.1); the pattern alone does not establish it."
              },
              "nbf": {
                "type": "integer",
                "minimum": 0,
                "maximum": 253402300799
              },
              "exp": {
                "type": "integer",
                "minimum": 1,
                "maximum": 253402300799,
                "description": "Must be greater than nbf (WIST-1 section 5.1)."
              }
            }
          }
        },
        "next_keys": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "Key Set fingerprint of the signing set the next ordinary rotation installs (WIST-1 section 5.2)."
        },
        "contact": {
          "type": "string",
          "maxLength": 256
        },
        "collections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "description": "The Publisher's Collections: each names a disjoint Scope of its URLs and optional keys that sign that Collection's Catalogs alone. A Declaration without collections has one implicit Collection, default, whose Scope is every URL of its authority (WIST-1 §3.5). maxItems is the collections_max default; the amended value governs.",
          "items": {
            "type": "object",
            "required": [
              "name",
              "scope"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9]([a-z0-9-]{0,30}[a-z0-9])?$(?![\\s\\S])",
                "description": "Unique among the Declaration's Collections."
              },
              "scope": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "description": "maxItems is the scope_entries_max default; the amended value governs. Entries of distinct Collections cover no common URL.",
                "items": {
                  "type": "object",
                  "required": [
                    "url",
                    "match"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "url": {
                      "type": "string",
                      "format": "uri",
                      "pattern": "^https://[^#]*$",
                      "maxLength": 2048,
                      "description": "A Normalized URL on a host of the Declaration's authority, JCS octets within url_cap_bytes."
                    },
                    "match": {
                      "enum": [
                        "prefix",
                        "exact"
                      ],
                      "description": "prefix covers every URL that starts with url, compared as octets; exact covers url alone."
                    }
                  }
                }
              },
              "keys": {
                "type": "array",
                "items": {
                  "$ref": "#/properties/publisher/properties/keys/items"
                },
                "description": "Keys that sign this Collection's Catalogs and nothing else; each public key appears once across the Declaration."
              }
            }
          }
        }
      }
    },
    "sig": {
      "type": "object",
      "required": [
        "key_id",
        "alg",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "key_id": {
          "type": "string",
          "maxLength": 64
        },
        "alg": {
          "const": "Ed25519"
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{85}[AQgw]$(?![\\s\\S])"
        }
      }
    }
  }
}
