{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wistprotocol.org/schemas/publisher.schema.json",
  "title": "WIST Publisher Declaration (WIST-1)",
  "type": "object",
  "required": ["publisher", "sig"],
  "additionalProperties": false,
  "properties": {
    "publisher": {
      "type": "object",
      "required": ["wist_version", "domain", "keys", "seq"],
      "additionalProperties": false,
      "properties": {
        "wist_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
        "domain": {"type": "string", "format": "hostname"},
        "seq": {"type": "integer", "minimum": 0},
        "prev_declaration": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "subdomain_scope": {"type": "array", "items": {"type": "string", "format": "hostname"}},
        "keys": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["key_id", "alg", "public_key", "valid_from"],
            "additionalProperties": false,
            "properties": {
              "key_id": {"type": "string", "maxLength": 64},
              "alg": {"const": "Ed25519"},
              "public_key": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"},
              "valid_from": {"type": "string", "format": "date-time"}
            }
          }
        },
        "recovery_keys": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["key_id", "alg", "public_key", "valid_from"],
            "additionalProperties": false,
            "properties": {
              "key_id": {"type": "string", "maxLength": 64},
              "alg": {"const": "Ed25519"},
              "public_key": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"},
              "valid_from": {"type": "string", "format": "date-time"}
            }
          }
        },
        "contact": {"type": "string", "maxLength": 256}
      }
    },
    "sig": {
      "type": "object",
      "required": ["key_id", "alg", "value"],
      "additionalProperties": false,
      "properties": {
        "key_id": {"type": "string", "maxLength": 64},
        "alg": {"const": "Ed25519"},
        "value": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}$"}
      }
    }
  }
}
