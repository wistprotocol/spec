{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wistprotocol.org/schemas/publisher.schema.json",
  "title": "WIST Publisher Declaration (WIST-1)",
  "$comment": "WIST-1 section 5.2 additionally requires key_id uniqueness across keys and recovery_keys, disjoint public_key values across those sets, and authenticated signer resolution. Section 5.1 requires format assertions and classifies field failures as WIST1-E14; section 4 derives usable cryptographic keys without deleting signed entries or relaxing identifier uniqueness, disjointness or recovery protection.",
  "type": "object",
  "required": ["publisher", "sig"],
  "additionalProperties": false,
  "properties": {
    "publisher": {
      "type": "object",
      "required": ["wist_version", "domain", "keys", "seq"],
      "additionalProperties": false,
      "properties": {
        "wist_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
        "domain": {"type": "string", "format": "wist-canonical-host", "minLength": 1, "maxLength": 253, "pattern": "^[a-z0-9-]{1,63}(\\.[a-z0-9-]{1,63})*$(?![\\s\\S])", "description": "Must equal its own Canonical Host under WIST-1 sections 2 and 5.1, including Unicode 16.0 UTS #46 A-label validation; the pattern alone is insufficient."},
        "seq": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "prev_declaration": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "subdomain_scope": {"type": "array", "items": {"type": "string", "format": "wist-canonical-host", "minLength": 1, "maxLength": 253, "pattern": "^[a-z0-9-]{1,63}(\\.[a-z0-9-]{1,63})*$(?![\\s\\S])", "description": "Must equal its own Canonical Host under WIST-1 sections 2 and 5.1, including Unicode 16.0 UTS #46 A-label validation; the pattern alone is insufficient."}},
        "keys": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["key_id", "alg", "public_key", "valid_from"],
            "additionalProperties": false,
            "properties": {
              "key_id": {"type": "string", "maxLength": 64},
              "alg": {"const": "Ed25519"},
              "public_key": {"type": "string", "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$(?![\\s\\S])"},
              "valid_from": {"type": "string", "format": "date-time"}
            }
          }
        },
        "recovery_keys": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["key_id", "alg", "public_key", "valid_from"],
            "additionalProperties": false,
            "properties": {
              "key_id": {"type": "string", "maxLength": 64},
              "alg": {"const": "Ed25519"},
              "public_key": {"type": "string", "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$(?![\\s\\S])"},
              "valid_from": {"type": "string", "format": "date-time"}
            }
          }
        },
        "contact": {"type": "string", "maxLength": 256}
      }
    },
    "sig": {
      "type": "object",
      "required": ["key_id", "alg", "value"],
      "additionalProperties": false,
      "properties": {
        "key_id": {"type": "string", "maxLength": 64},
        "alg": {"const": "Ed25519"},
        "value": {"type": "string", "pattern": "^[A-Za-z0-9_-]{85}[AQgw]$(?![\\s\\S])"}
      }
    }
  }
}
