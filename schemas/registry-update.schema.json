{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deltacommons.org/schemas/registry-update.schema.json",
  "title": "DeltaCommons Registry Update (DC-4)",
  "type": "object",
  "required": ["update", "sig"],
  "additionalProperties": false,
  "properties": {
    "update": {
      "type": "object",
      "required": ["dc_version", "action", "subject", "effective_at"],
      "additionalProperties": false,
      "properties": {
        "dc_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
        "action": {"enum": ["aggregator_key_add", "aggregator_key_remove", "auditor_admit", "auditor_remove", "sanction", "sanction_lift", "notice", "appeal", "appeal_ruling", "parameter_change", "coverage_attestation"]},
        "subject": {"type": "string", "maxLength": 256},
        "details": {"type": "object"},
        "evidence": {"type": "array", "items": {"type": "string", "maxLength": 256}},
        "effective_at": {"type": "string", "format": "date-time"}
      }
    },
    "sig": {
      "type": "object",
      "required": ["key_id", "alg", "value"],
      "additionalProperties": false,
      "properties": {
        "key_id": {"type": "string", "maxLength": 64},
        "alg": {"const": "Ed25519"},
        "value": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}$"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"update": {"properties": {"action": {"enum": ["aggregator_key_add", "auditor_admit"]}}}}},
      "then": {
        "properties": {
          "update": {
            "required": ["details"],
            "properties": {
              "details": {
                "type": "object",
                "required": ["key_id", "alg", "public_key"],
                "properties": {
                  "key_id": {"type": "string", "maxLength": 64},
                  "alg": {"const": "Ed25519"},
                  "public_key": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"}
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"update": {"properties": {"action": {"enum": ["aggregator_key_remove", "auditor_remove"]}}}}},
      "then": {
        "properties": {
          "update": {
            "required": ["details"],
            "properties": {
              "details": {
                "type": "object",
                "required": ["key_id"],
                "properties": {
                  "key_id": {"type": "string", "maxLength": 64}
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"update": {"properties": {"action": {"const": "sanction"}}}}},
      "then": {
        "properties": {
          "update": {
            "required": ["details", "evidence"],
            "properties": {
              "details": {
                "type": "object",
                "required": ["level", "severity"],
                "properties": {
                  "level": {"type": "integer", "minimum": 1, "maximum": 4},
                  "severity": {"type": "integer", "minimum": 1, "maximum": 3}
                }
              },
              "evidence": {
                "type": "array",
                "minItems": 2,
                "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
              }
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"update": {"properties": {"action": {"const": "notice"}}}}},
      "then": {
        "properties": {
          "update": {
            "required": ["details"],
            "properties": {
              "details": {
                "type": "object",
                "required": ["kind"],
                "properties": {
                  "kind": {"enum": ["sanction", "recovery"]},
                  "reason": {"type": "string", "minLength": 1, "maxLength": 1024},
                  "appeal_deadline": {"type": "string", "format": "date-time"}
                },
                "if": {"properties": {"kind": {"const": "sanction"}}},
                "then": {"required": ["reason", "appeal_deadline"]}
              }
            },
            "if": {"properties": {"details": {"properties": {"kind": {"const": "sanction"}}}}},
            "then": {"required": ["evidence"]}
          }
        }
      }
    },
    {
      "if": {"properties": {"update": {"properties": {"action": {"const": "appeal_ruling"}}}}},
      "then": {
        "properties": {
          "update": {
            "required": ["details"],
            "properties": {
              "details": {
                "type": "object",
                "required": ["outcome", "reasoning"],
                "properties": {
                  "outcome": {"enum": ["upheld", "overturned"]},
                  "reasoning": {"type": "string", "minLength": 1, "maxLength": 1024}
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"update": {"properties": {"action": {"const": "parameter_change"}}}}},
      "then": {
        "properties": {
          "update": {
            "required": ["details"],
            "properties": {
              "details": {
                "type": "object",
                "required": ["parameter", "value"],
                "properties": {
                  "parameter": {"enum": [
                    "block_cadence_seconds", "block_decompressed_cap_bytes", "extract_cap_bytes",
                    "summary_cap_bytes", "feed_window", "clock_skew_seconds", "baseline_poll_seconds",
                    "keyset_cache_ttl_seconds", "recovery_window_days", "sampling_floor",
                    "sampling_ceiling", "sampling_slope", "similarity_consistent",
                    "similarity_variance_floor", "shingle_size", "confirm_auditors",
                    "confirm_window_hours", "coverage_deadline_hours", "age_norm_days",
                    "decay_constant_days", "decay_horizon_days", "penalty_weight", "c_cap",
                    "provisional_age_days", "provisional_audits", "provisional_cap_u",
                    "quota_base", "quota_slope", "latency_threshold_u", "escalation_l2",
                    "escalation_l3", "escalation_l4", "appeal_window_days", "ruling_deadline_days",
                    "param_grace_days"
                  ]},
                  "value": {"type": "number"}
                },
                "allOf": [
                  {
                    "if": {"properties": {"parameter": {"const": "penalty_weight"}}},
                    "then": {"properties": {"value": {"minimum": 1}}}
                  },
                  {
                    "if": {"properties": {"parameter": {"const": "confirm_auditors"}}},
                    "then": {"properties": {"value": {"minimum": 2}}}
                  },
                  {
                    "if": {"properties": {"parameter": {"const": "similarity_variance_floor"}}},
                    "then": {"properties": {"value": {"minimum": 150001}}}
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
