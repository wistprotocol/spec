{
  "note": "WIST-3 \u00a77, one URL, one Publisher: `records` lists the Publishers holding a record of one URL of host at a height, each with whether a withdrawal sealed at or below that height names the record's Item; self_declared says whether the first publisher_declaration Entry whose domain is the host is sealed at or below that height. Only records no such withdrawal names are candidates. materialized names the Publisher whose record the Snapshot carries, null when the rule selects none. Which records a Log holds is carried by vectors/wist3/record-materialization.json.",
  "cases": [
    {
      "label": "self declaration prevails",
      "host": "a.example.com",
      "self_declared": true,
      "records": [
        {
          "publisher": "example.com",
          "withdrawn": false
        },
        {
          "publisher": "a.example.com",
          "withdrawn": false
        }
      ],
      "materialized": "a.example.com"
    },
    {
      "label": "self declaration excludes parents without an own record",
      "host": "a.example.com",
      "self_declared": true,
      "records": [
        {
          "publisher": "example.com",
          "withdrawn": false
        }
      ],
      "materialized": null
    },
    {
      "label": "nearest ancestor",
      "host": "a.b.example.com",
      "self_declared": false,
      "records": [
        {
          "publisher": "example.com",
          "withdrawn": false
        },
        {
          "publisher": "b.example.com",
          "withdrawn": false
        }
      ],
      "materialized": "b.example.com"
    },
    {
      "label": "ancestor over non ancestor",
      "host": "a.example.com",
      "self_declared": false,
      "records": [
        {
          "publisher": "zeta.example",
          "withdrawn": false
        },
        {
          "publisher": "example.com",
          "withdrawn": false
        }
      ],
      "materialized": "example.com"
    },
    {
      "label": "non ancestors in octet order",
      "host": "a.example.com",
      "self_declared": false,
      "records": [
        {
          "publisher": "zeta.example",
          "withdrawn": false
        },
        {
          "publisher": "alpha.example",
          "withdrawn": false
        }
      ],
      "materialized": "alpha.example"
    },
    {
      "label": "single scoped publisher",
      "host": "a.example.com",
      "self_declared": false,
      "records": [
        {
          "publisher": "other.example",
          "withdrawn": false
        }
      ],
      "materialized": "other.example"
    },
    {
      "label": "label boundary is not a suffix match",
      "host": "a.notexample.com",
      "self_declared": false,
      "records": [
        {
          "publisher": "example.com",
          "withdrawn": false
        },
        {
          "publisher": "beta.example",
          "withdrawn": false
        }
      ],
      "materialized": "beta.example"
    },
    {
      "label": "a withdrawn nearest ancestor",
      "host": "a.b.example.com",
      "self_declared": false,
      "records": [
        {
          "publisher": "example.com",
          "withdrawn": false
        },
        {
          "publisher": "b.example.com",
          "withdrawn": true
        }
      ],
      "materialized": "example.com"
    },
    {
      "label": "a withdrawn ancestor beside a non ancestor",
      "host": "a.example.com",
      "self_declared": false,
      "records": [
        {
          "publisher": "example.com",
          "withdrawn": true
        },
        {
          "publisher": "zeta.example",
          "withdrawn": false
        }
      ],
      "materialized": "zeta.example"
    },
    {
      "label": "a self declared host whose own record is withdrawn",
      "host": "a.example.com",
      "self_declared": true,
      "records": [
        {
          "publisher": "example.com",
          "withdrawn": false
        },
        {
          "publisher": "a.example.com",
          "withdrawn": true
        }
      ],
      "materialized": null
    }
  ]
}
