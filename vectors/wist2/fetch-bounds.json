        },
        {
          "redirect_to": "https://example.com/feed-moved.json",
          "allowed": true
        },
        {
          "declaration": {
            "domain": "example.com",
            "subdomain_scope": [
              "www.example.com"
            ]
          }
        },
        {
          "redirect_to": "https://www.example.com/.well-known/wist/feed.json",
          "allowed": true
        },
        {
