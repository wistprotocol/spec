        {
          "page": 1,
          "current_keys": [
            "k1"
          ],
          "next_keys": [
            "k2"
          ],
          "verifies_under": "current",
          "verifies": true
        },
        {
          "page": 2,
          "current_keys": [
            "k1"
          ],
          "next_keys": [
            "k2"
          ],
          "verifies_under": null,
          "verifies": false
        }
      ],
      "why": "\u00a73.2: the Publisher rotated to k2 and cut a Page before an Aggregator sealed the rotation; k2 is in the first Declaration sealed after generated_at, so the Page verifies; k1 was current; k3 belongs to the second Declaration after, which the rule never reaches."
    },
