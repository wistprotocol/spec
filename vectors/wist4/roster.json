  "batch_cases": [
    {
      "label": "two rotations preserve incumbent",
      "initial_after_removals": {
        "observers": {
          "watch.alpha.test": {
            "key_id": "old",
            "public_key": "pk old"
          }
        },
        "auditors": {},
        "barred": [],
        "retired_key_ids": [],
        "retired_public_keys": []
      },
      "acts": [
        {
          "action": "observer_register",
          "subject": "watch.alpha.test",
          "key_id": "new a",
          "public_key": "pk new a"
        },
        {
          "action": "observer_register",
          "subject": "watch.alpha.test",
          "key_id": "new b",
          "public_key": "pk new b"
        }
      ],
      "expected": {
        "rejected_indices": [
          0,
          1
        ],
        "auditors": {},
        "observers": {
          "watch.alpha.test": {
            "key_id": "old",
            "public_key": "pk old"
          }
        }
      }
    },
